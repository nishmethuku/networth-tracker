# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Finnhub API key (free tier): https://finnhub.io/dashboard
FINNHUB_API_KEY=your_finnhub_api_key_here

# Supabase — Project Settings → API Keys / Data API / Database
# SUPABASE_URL is required: the backend verifies user access tokens against
# this project's JWKS endpoint (https://<project>.supabase.co/auth/v1/.well-known/jwks.json),
# no separate JWT secret needed.
DATABASE_URL=postgresql://postgres.xxxx:your_db_password@your-pooler-host.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_secret_or_service_role_key

# Shared secret the daily snapshot cron job sends via X-Snapshot-Secret header
SNAPSHOT_SECRET=generate_a_random_string_here

# Frontend origin allowed by CORS in production (e.g. https://your-app.vercel.app)
FRONTEND_URL=http://localhost:5173
