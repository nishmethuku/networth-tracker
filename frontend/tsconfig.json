{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Incremental adoption: .jsx/.js files are allowed and left
       unchecked (checkJs: false) so the bulk of the frontend can convert
       one component at a time later. .ts/.tsx files ARE checked, starting
       with the api layer and pure utils — no runtime UI dependency,
       highest value for catching a mismatched field name early. */
    "allowJs": true,
    "checkJs": false,

    /* Bundler mode (matches Vite) */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "e2e", "playwright.config.ts"]
}
